# 서버
PORT=3000
JWT_SECRET=아무-랜덤-문자열-바꿔서-사용

# Supabase (DB + 이미지 저장)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=서비스-롤-키

# Google 로그인 (Google Cloud Console > OAuth 2.0 클라이언트 ID)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# 사이트 기본 주소 (소셜 로그인 후 되돌아올 주소 계산용, 배포 시 실제 도메인으로)
APP_BASE_URL=http://localhost:3000

# 카카오 로그인 - developers.kakao.com > 내 애플리케이션 > 카카오 로그인 활성화
# REST API 키는 위 KAKAO_REST_API_KEY와 동일한 값을 그대로 씁니다.
# 카카오 로그인 > Redirect URI에 아래 주소 등록 (배포 시 도메인으로 추가 등록)
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# 네이버 로그인 - developers.naver.com/apps (NCP 지도 콘솔과는 다른 사이트입니다)
# 애플리케이션 등록 > 네이버 로그인 사용 설정 > 서비스 URL / Callback URL 등록
NAVER_LOGIN_CLIENT_ID=네이버로그인-Client-ID
NAVER_LOGIN_CLIENT_SECRET=네이버로그인-Client-Secret
NAVER_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/naver/callback

# 이메일 인증코드 발송용 SMTP (Gmail 앱 비밀번호 사용 예시)
# Google 계정 > 보안 > 2단계 인증 켠 뒤 "앱 비밀번호" 발급해서 SMTP_PASS에 입력
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=앱-비밀번호-16자리
SMTP_FROM=찐맛집 <your-gmail@gmail.com>

# 카카오맵 (지도 표시 + 장소 실존/거리 검증용) - developers.kakao.com
KAKAO_JS_KEY=지도-표시용-JS-키
KAKAO_REST_API_KEY=장소검색-REST-키

# 네이버 지도 (지도 표시 선택지) - console.ncloud.com > AI·Application Service > Maps
NAVER_MAP_CLIENT_ID=네이버클라우드-Client-ID

# 구글 지도 표시용 (Maps JavaScript API) - console.cloud.google.com
# GOOGLE_PLACES_API_KEY와 같은 키를 써도 됨 (Maps JavaScript API도 같이 사용 설정하면 됨)
GOOGLE_MAPS_JS_KEY=지도-표시용-구글-키

# 구글 Places (평점/리뷰수 자동 확보용) - console.cloud.google.com
# "Places API" 활성화 후 API 키 발급 (Maps JS API와 별도 키 써도 됨)
GOOGLE_PLACES_API_KEY=xxxxxxxx

# AI 이중검증 (선택, 있으면 애매한 케이스만 AI가 판단)
ANTHROPIC_API_KEY=sk-ant-xxxx
