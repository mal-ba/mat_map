# 서버
PORT=3000
JWT_SECRET=아무-랜덤-문자열-바꿔서-사용

# Supabase (DB + 이미지 저장)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=서비스-롤-키

# Google 로그인 (Google Cloud Console > OAuth 2.0 클라이언트 ID)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# 카카오맵 (지도 표시 + 장소 실존/거리 검증용) - developers.kakao.com
KAKAO_JS_KEY=지도-표시용-JS-키
KAKAO_REST_API_KEY=장소검색-REST-키

# 네이버 지도 (지도 표시 선택지) - console.ncloud.com > AI·Application Service > Maps
NAVER_MAP_CLIENT_ID=네이버클라우드-Client-ID

# 구글 지도 표시용 (Maps JavaScript API) - console.cloud.google.com
# GOOGLE_PLACES_API_KEY와 같은 키를 써도 됨 (Maps JavaScript API도 같이 사용 설정하면 됨)
GOOGLE_MAPS_JS_KEY=지도-표시용-구글-키

# 구글 Places (평점/리뷰수 자동 확보용) - console.cloud.google.com
# "Places API" 활성화 후 API 키 발급 (Maps JS API와 별도 키 써도 됨)
GOOGLE_PLACES_API_KEY=xxxxxxxx

# AI 이중검증 (선택, 있으면 애매한 케이스만 AI가 판단)
ANTHROPIC_API_KEY=sk-ant-xxxx
